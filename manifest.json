{
  "manifest_version": 3,
  "name": "Arc-Adjacent Pinned Tabs",
  "version": "1.0",
  "description": "Opens a new tab when all unpinned tabs are closed, somewhat mimicking Arc Browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "b@krml.me",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}